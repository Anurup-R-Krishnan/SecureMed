# ── Django ─────────────────────────────────────────────────────────
DEBUG=True
SECRET_KEY=your-secret-key-here
ALLOWED_HOSTS=localhost,127.0.0.1

# Set to True in production to force HTTPS-only cookies, HSTS, and SSL redirect
# DJANGO_SECURE_SSL=True

# ── Database (docker-compose overrides DB_HOST to "db") ───────────
DB_ENGINE=django.db.backends.postgresql
DB_NAME=securemed
DB_USER=postgres
DB_PASSWORD=123
DB_HOST=localhost
DB_PORT=5432

# ── Cache / Celery (docker-compose overrides REDIS_URL to the redis service) ──
REDIS_URL=redis://localhost:6379/1
# Run Celery tasks synchronously in development (1/true/yes)
# CELERY_TASK_ALWAYS_EAGER=True

# ── CORS ──────────────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ── Auth / MFA ────────────────────────────────────────────────────
# Toggle MFA enforcement (defaults to True)
# MFA_ENABLED=True
# TOTP clock tolerance window (1 or 2)
# MFA_TOTP_VALID_WINDOW=1
# Google reCAPTCHA v2 secret key (defaults to Google's always-pass test key)
# RECAPTCHA_SECRET_KEY=

# ── Email ─────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@securemed.com
FRONTEND_URL=http://localhost:3000
# SMTP settings (used when EMAIL_BACKEND is an SMTP backend)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=

# ── Neo4j Graph Database (docker-compose overrides NEO4J_URI to bolt://neo4j:7687)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=securemed_graph

# ── Google Gemini AI (optional; endpoints degrade gracefully without it)
GOOGLE_GEMINI_API_KEY=your-key-here
